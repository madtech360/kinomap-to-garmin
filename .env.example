# Settings for kinomap-to-garmin.
# Copy this file to ".env", replace the dummy values with your own, then run: chmod 600 .env
# Do not put quotes around values (docker compose would keep them as part of the value).

# ---- Mailbox (IMAP) ----
IMAP_HOST=imap.gmail.com
IMAP_USER=your.name@gmail.com
# Gmail/Outlook need an app password, not your normal password
IMAP_PASSWORD=abcd-efgh-ijkl-mnop
IMAP_FOLDER=INBOX

# ---- Which emails to pick up ----
# Only emails whose From contains this text
KINOMAP_FROM=kinomap
# Only emails whose Subject contains this text
KINOMAP_SUBJECT=activity

# ---- Garmin (used only for the one-time --login step) ----
GARMIN_EMAIL=your.name@example.com
GARMIN_PASSWORD=your-garmin-password

# ---- Activity type in Garmin, chosen from the TCX "Sport" value ----
# Format: tcxsport:garmin_type_key,tcxsport:garmin_type_key  (TCX side is not case-sensitive)
# Leave empty (SPORT_MAP=) to keep Garmin's default type
SPORT_MAP=rowing:indoor_rowing,running:elliptical

# ---- Activity name in Garmin, e.g. "Indoor Rowing" / "Elliptical" ----
# 1 = rename after setting the type, 0 = keep Garmin's name
SET_NAME=1
# Name for each Garmin type key (same format as SPORT_MAP)
TYPE_LABELS=indoor_rowing:Indoor Rowing,elliptical:Elliptical
# Optional: 1 adds Morning/Afternoon/Evening/Night in front ("Evening Indoor Rowing")
NAME_TIME_OF_DAY=0
# Only used when NAME_TIME_OF_DAY=1. The TCX times are UTC, so give your own time zone.
# Examples: Asia/Kolkata, Europe/London, America/New_York
LOCAL_TZ=Asia/Kolkata

# ---- Storage paths inside the container (the Dockerfile already sets these) ----
GARMIN_TOKENS=/data/garminconnect
STATE_FILE=/data/state.json
# Rotating log file (1 MB x 6 files), every line tagged with the run's trace id
LOG_FILE=/data/logs/k2g.log
# INFO (default) or DEBUG, which adds the raw Garmin replies and each status check
LOG_LEVEL=INFO

# ---- Home Assistant trigger (MODE=trigger) ----
# "trigger" waits for a button press in Home Assistant; "loop" runs on a timer instead
MODE=trigger
# Random secret, at least 16 characters. Generate one with: openssl rand -hex 24
# (the server refuses to start while this still says change-me...)
TRIGGER_TOKEN=change-me-generate-with-openssl-rand-hex-24
TRIGGER_PORT=8765
# Seconds before a single run is killed
RUN_TIMEOUT=300

# ---- Only used when MODE=loop ----
# Seconds between runs (900 = 15 minutes)
INTERVAL=900

# ---- Network ----
# Address the trigger port is published on. 127.0.0.1 = this machine only (safe default).
# Set to your server's LAN IP (e.g. 192.168.1.50) so Home Assistant on another machine can reach it.
# Never expose this port to the internet.
TRIGGER_BIND=127.0.0.1
